* text=auto

# Shell scripts, compose/CI files and the container build must keep LF endings: the
# development host is Windows, `docker compose exec` fails on CR artifacts, and a CR in
# the Dockerfile or in start.sh turns the ENTRYPOINT into a "not found" inside the image.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
deploy/Caddyfile text eol=lf
deploy/Caddyfile.staging text eol=lf

# The calendar objects of the measuring spike (phase 30) are raw evidence and later
# fixtures: they keep the bytes the server sent, CRLF line ends included.
.planning/phases/30-mess-spike-aufgaben-und-ordner/raw/**/*.ics -text
